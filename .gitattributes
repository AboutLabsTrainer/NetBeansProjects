# Text files are stored with LF. Windows checkouts may convert to CRLF, except where the shell needs LF.
* text=auto

# Unix scripts must keep LF, otherwise bash in WSL fails with "$'\r': command not found".
*.sh   text eol=lf
mvnw   text eol=lf

# Windows scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binaries
*.jar  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
