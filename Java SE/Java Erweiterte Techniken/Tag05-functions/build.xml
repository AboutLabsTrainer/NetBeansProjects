<?xml version="1.0" encoding="UTF-8"?>
<project name="05-functional-interfaces" default="run" basedir=".">
    <description>Functional Interfaces Mini-Challenge - Ant Projekt</description>
    
    <!-- Properties -->
    <property name="src.dir" value="src"/>
    <property name="build.dir" value="build"/>
    <property name="classes.dir" value="${build.dir}/classes"/>
    <property name="main.class" value="MiniChallenge"/>
    
    <!-- Classpath -->
    <path id="classpath">
        <pathelement location="${classes.dir}"/>
    </path>
    
    <!-- Clean target -->
    <target name="clean" description="Löscht generierte Dateien">
        <delete dir="${build.dir}"/>
    </target>
    
    <!-- Init target -->
    <target name="init" description="Erstellt Build-Verzeichnisse">
        <mkdir dir="${build.dir}"/>
        <mkdir dir="${classes.dir}"/>
    </target>
    
    <!-- Compile target -->
    <target name="compile" depends="init" description="Kompiliert die Java-Quellen">
        <javac srcdir="${src.dir}" 
               destdir="${classes.dir}" 
               includeantruntime="false"
               source="1.8"
               target="1.8"
               encoding="UTF-8">
            <classpath refid="classpath"/>
        </javac>
    </target>
    
    <!-- Run target -->
    <target name="run" depends="compile" description="Führt die Main-Klasse aus">
        <java classname="${main.class}" fork="true">
            <classpath refid="classpath"/>
        </java>
    </target>
    
    <!-- Jar target -->
    <target name="jar" depends="compile" description="Erstellt ein JAR-File">
        <jar destfile="${build.dir}/${ant.project.name}.jar" basedir="${classes.dir}">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
            </manifest>
        </jar>
    </target>
    
    <!-- All target -->
    <target name="all" depends="clean,compile,jar" description="Führt alle Targets aus"/>
</project>
