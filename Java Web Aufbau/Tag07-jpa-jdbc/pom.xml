<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.javadeveloper</groupId>
  <artifactId>Tag7</artifactId>
  <version>1.0.0</version>
  <packaging>war</packaging>
  <name>Tag7 – JPA vs JDBC • Provider &amp; Konfiguration</name>
  <description>Mini‑Challenge: JPA Product mit Hibernate Provider + JDBC Vergleich (Payara 6)</description>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jakarta.ee.version>10.0.0</jakarta.ee.version>
    <hibernate.version>6.5.2.Final</hibernate.version>
  </properties>

  <dependencies>
    <!-- Jakarta EE Web API (provided by Payara 6) -->
    <dependency>
      <groupId>jakarta.platform</groupId>
      <artifactId>jakarta.jakartaee-web-api</artifactId>
      <version>${jakarta.ee.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Hibernate ORM as JPA provider (Jakarta) -->
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-core</artifactId>
      <version>${hibernate.version}</version>
    </dependency>

    <!-- MariaDB JDBC driver (provided by Payara) -->
    <dependency>
      <groupId>org.mariadb.jdbc</groupId>
      <artifactId>mariadb-java-client</artifactId>
      <version>3.5.6</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>Tag7</finalName>
  </build>
</project>
