{
  "title": "Spring Boot Actuator – Tag 9",
  "uid": "tag9-actuator",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "User Registrations per Minute",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(users_registered_total[5m]) * 60",
          "legendFormat": "registrations/min"
        }
      ]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Avg Registration Duration (seconds)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "rate(users_registration_duration_seconds_sum[5m]) / rate(users_registration_duration_seconds_count[5m])",
          "legendFormat": "avg"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Heap Memory Usage (%)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"} / jvm_memory_max_bytes{area=\"heap\"} * 100",
          "legendFormat": "{{ id }}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP Requests per Second by Endpoint",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count[5m])) by (uri, method)",
          "legendFormat": "{{ method }} {{ uri }}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "95th Percentile Response Time by Endpoint",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, uri))",
          "legendFormat": "{{ uri }}"
        }
      ]
    }
  ]
}
