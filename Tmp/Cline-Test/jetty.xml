<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Configure PUBLIC "-//Jetty//Configure//EN" "http://www.eclipse.org/jetty/configure.dtd">
<!-- Minimal Jetty configuration: overrides the HTTP connector port.
     Port 8080 is occupied by a pre-existing Payara Server, so we run on 8081.
     The jetty-maven-plugin still supplies the WebAppContext, classpath
     (target/classes), temp directory and scanning via its <webApp> config. -->
<Configure id="Server" class="org.eclipse.jetty.server.Server">

    <New id="httpConnector" class="org.eclipse.jetty.server.ServerConnector">
        <Arg name="server"><Ref refid="Server"/></Arg>
        <Set name="port">8081</Set>
    </New>

    <Set name="connectors">
        <Array type="org.eclipse.jetty.server.Connector">
            <Item><Ref refid="httpConnector"/></Item>
        </Array>
    </Set>

</Configure>